[
  {
    "kernelSource": {
      "name": "chopin-KernelSU-release",
      "repo": "https://github.com/ChopinKernels/kernel_xiaomi_chopin",
      "branch": "r",
      "device": "chopin",
      "defconfig": "chopin_user_defconfig"
    },
    "withKernelSU": true,
    "toolchains": [
      {
        "url": "https://github.com/ZyCromerZ/Clang/releases/download/15.0.7-20260208-release/Clang-15.0.7-20260208.tar.gz",
        "name": "ZyC-clang",
        "binPath": [
          "bin"
        ]
      }
    ],
    "ccache": false,
    "params": {
      "ARCH": "arm64",
      "CC": "ZyC-clang/bin/clang",
      "externalCommand": {
        "HOSTCC": "gcc",
        "HOSTCXX": "g++",
        "HOSTLD": "ld",
        "CLANG_TRIPLE": "aarch64-linux-gnu-",
        "CROSS_COMPILE": "aarch64-linux-gnu-",
        "CROSS_COMPILE_ARM32": "arm-linux-gnueabi-",
        "LD": "ZyC-clang/bin/ld.lld",
        "AR": "ZyC-clang/bin/llvm-ar",
        "NM": "ZyC-clang/bin/llvm-nm",
        "OBJCOPY": "ZyC-clang/bin/llvm-objcopy",
        "OBJDUMP": "ZyC-clang/bin/llvm-objdump",
        "READELF": "ZyC-clang/bin/llvm-readelf",
        "STRIP": "ZyC-clang/bin/llvm-strip",
        "LLVM_AR": "ZyC-clang/bin/llvm-ar",
        "LLVM_DIS": "ZyC-clang/bin/llvm-dis"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/osm0sis/AnyKernel3",
      "branch": "master"
    }
  }
]
